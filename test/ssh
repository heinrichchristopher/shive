#!/usr/bin/env python3
# fake ssh: drop options, run the remote command locally through bash -c (stdin/stdout pass through)
import sys, subprocess
a=sys.argv[1:]; i=0
while i < len(a) and a[i].startswith('-'):
    i += 2 if a[i] in ('-o','-p','-i') else 1
host=a[i]; cmd=' '.join(a[i+1:])
open('/tmp/ssh.log','a').write(f"{host}: {cmd}\n")
sys.exit(subprocess.call(['bash','-c',cmd]) if cmd else 0)
