#!/usr/bin/env python3
import sys, json, os
s = json.load(open('/tmp/fakezfs.json')) if os.path.exists('/tmp/fakezfs.json') else {'ds':{}}
pools = sorted({n.split('/')[0] for n in s['ds']})
a = sys.argv[1:]
if a and a[0]=='list':
    cols = a[a.index('-o')+1].split(',') if '-o' in a else ['name']
    target = [x for x in a[1:] if not x.startswith('-') and x not in cols and ','.join(cols)!=x]
    for p in (target or pools):
        if p not in pools: print(f"cannot open '{p}': no such pool", file=sys.stderr); sys.exit(1)
        print('\t'.join({'name':p,'health':'ONLINE','size':'1T','free':'500G'}[c] for c in cols))
